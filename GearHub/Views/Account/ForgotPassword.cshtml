@{
    ViewBag.Title = "Quên mật khẩu";
}

<main class="account-page">
    <div class="site-container">
        <nav class="category-breadcrumb" aria-label="Đường dẫn trang">
            <a href="@Url.Action("Index", "Home")">Trang chủ</a>
            <span aria-hidden="true">/</span>
            <a href="@Url.Action("Login", "Account")">Tài khoản</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">Quên mật khẩu</span>
        </nav>

        <div class="account-card account-card-forgot">
            <section class="account-welcome">
                <p class="account-kicker">GEARHUB / HỖ TRỢ TÀI KHOẢN</p>
                <h1>Lấy lại quyền truy cập</h1>
                <p>Nhập email của tài khoản để bắt đầu đặt lại mật khẩu.</p>
                <span class="account-mark" aria-hidden="true">GH</span>
            </section>

            <section class="account-form-panel">
                <p class="account-form-label">Khôi phục tài khoản</p>
                <h2>Quên mật khẩu?</h2>
                <p class="account-form-note">Nhập email, mã xác minh và mật khẩu mới của bạn.</p>

                <form class="account-form">
                    <label for="reset-email">Email</label>
                    <div class="account-verification-row">
                        <input id="reset-email" type="email" name="email" placeholder="name@example.com" autocomplete="email" required />
                        <button id="send-reset-code" class="button button-outline account-send-code" type="button">Gửi mã</button>
                    </div>
                    <p id="reset-code-status" class="account-verification-status" role="status" aria-live="polite">Nhập email rồi chọn gửi mã xác minh.</p>

                    <label for="reset-code">Mã xác minh</label>
                    <input id="reset-code" type="text" name="verificationCode" placeholder="Nhập mã gồm 6 số" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required />

                    <label for="new-password">Mật khẩu mới</label>
                    <input id="new-password" type="password" name="password" placeholder="Tạo mật khẩu mới" autocomplete="new-password" required />

                    <label for="confirm-password">Nhập lại mật khẩu mới</label>
                    <input id="confirm-password" type="password" name="confirmPassword" placeholder="Nhập lại mật khẩu mới" autocomplete="new-password" required />

                    <button class="button button-primary account-submit" type="button">Đặt lại mật khẩu</button>
                </form>

                <p class="account-switch">Đã nhớ mật khẩu? <a href="@Url.Action("Login", "Account")">Quay lại đăng nhập</a></p>
            </section>
        </div>
    </div>
</main>

@section scripts {
    <script>
        // Kiểm tra email rồi khóa nút trong 30 giây trước khi cho bấm lại.
        document.getElementById("send-reset-code").addEventListener("click", function () {
            var email = document.getElementById("reset-email");
            var status = document.getElementById("reset-code-status");
            var button = document.getElementById("send-reset-code");

            if (!email.value.trim()) {
                status.textContent = "Bạn hãy nhập email trước khi gửi mã.";
                email.focus();
                return;
            }

            if (!email.checkValidity()) {
                status.textContent = "Email chưa đúng định dạng.";
                email.focus();
                return;
            }

            var secondsLeft = 30;
            button.disabled = true;
            button.textContent = "Gửi lại (" + secondsLeft + "s)";
            status.textContent = "Nút sẽ dùng lại được sau 30 giây. Mã chưa được gửi vì trang chưa kết nối với dịch vụ email.";

            var countdown = window.setInterval(function () {
                secondsLeft--;
                if (secondsLeft <= 0) {
                    window.clearInterval(countdown);
                    button.disabled = false;
                    button.textContent = "Gửi mã";
                    status.textContent = "Bạn có thể bấm gửi mã lại. Chức năng gửi email chưa được kết nối.";
                    return;
                }

                button.textContent = "Gửi lại (" + secondsLeft + "s)";
            }, 1000);
        });
    </script>
}