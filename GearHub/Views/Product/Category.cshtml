@{
    var categoryKey = ViewBag.CategoryKey as string ?? "pc-gaming";
    var categoryName = ViewBag.CategoryName as string ?? "PC Gaming";
    var products = ViewBag.Products as System.Collections.Generic.List<GearHub.Models.Entities.AdminProduct> ?? new System.Collections.Generic.List<GearHub.Models.Entities.AdminProduct>();
    ViewBag.Title = categoryName;
}

<main class="category-page">
    <div class="site-container">
        <!-- Đường dẫn nhỏ giúp người dùng quay lại trang chủ. -->
        <nav class="category-breadcrumb" aria-label="Đường dẫn trang">
            <a href="@Url.Action("Index", "Home")">Trang chủ</a>
            <span aria-hidden="true">/</span>
            <span aria-current="page">@categoryName</span>
        </nav>

        <header class="category-page-title">
            <h1>@categoryName</h1>
            <p>Chọn tiêu chí phù hợp với nhu cầu. Sản phẩm sẽ hiện ở khu vực bên phải khi bạn thêm dữ liệu.</p>
        </header>

        <div class="category-layout">
            <!-- Các lựa chọn dưới đây là khung giao diện để nhóm nối với dữ liệu sau này. -->
            <details class="category-filter-panel" aria-label="Bộ lọc @categoryName">
                <summary class="category-filter-heading">
                    <svg class="category-filter-icon" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#292d33" stroke-width="1.8" aria-hidden="true">
                        <path d="M4 6h16M4 12h16M4 18h16" />
                        <circle cx="8" cy="6" r="2" />
                        <circle cx="15" cy="12" r="2" />
                        <circle cx="10" cy="18" r="2" />
                    </svg>
                    <h2>Bộ lọc tìm kiếm</h2>
                    <svg class="category-filter-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M4 8l8 8 8-8" fill="none" stroke="#555d65" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
                    </svg>
                </summary>

                <div class="category-filter-body">
                    <details class="category-filter-group" open>
                        <summary>Khoảng giá</summary>
                        <div class="category-filter-options">
                            <label><input type="checkbox" name="price" value="all" checked /> Tất cả</label>
                            <label><input type="checkbox" name="price" value="under-15m" /> Dưới 15 triệu</label>
                            <label><input type="checkbox" name="price" value="15-30m" /> Từ 15 - 30 triệu</label>
                            <label><input type="checkbox" name="price" value="30-50m" /> Từ 30 - 50 triệu</label>
                            <label><input type="checkbox" name="price" value="50-100m" /> Từ 50 - 100 triệu</label>
                            <label><input type="checkbox" name="price" value="over-100m" /> Trên 100 triệu</label>
                        </div>
                        <label class="category-price-caption">Hoặc nhập khoảng giá phù hợp:</label>
                        <div class="category-price-inputs">
                            <input type="number" name="priceMin" min="0" placeholder="Giá từ" aria-label="Giá thấp nhất" />
                            <input type="number" name="priceMax" min="0" placeholder="Giá đến" aria-label="Giá cao nhất" />
                        </div>
                    </details>

                    @if (categoryKey == "console")
                    {
                        <details class="category-filter-group" open>
                            <summary>Nền tảng</summary>
                            <div class="category-filter-options">
                                <label><input type="checkbox" name="platform" value="all" checked /> Tất cả</label>
                                <label><input type="checkbox" name="platform" value="playstation" /> PlayStation</label>
                                <label><input type="checkbox" name="platform" value="xbox" /> Xbox</label>
                                <label><input type="checkbox" name="platform" value="nintendo" /> Nintendo</label>
                            </div>
                        </details>
                        <details class="category-filter-group">
                            <summary>Dòng máy</summary>
                            <div class="category-filter-options">
                                <label><input type="checkbox" name="consoleModel" value="all" checked /> Tất cả</label>
                                <label><input type="checkbox" name="consoleModel" value="ps5" /> PlayStation 5</label>
                                <label><input type="checkbox" name="consoleModel" value="ps5-pro" /> PlayStation 5 Pro</label>
                                <label><input type="checkbox" name="consoleModel" value="series-x" /> Xbox Series X</label>
                                <label><input type="checkbox" name="consoleModel" value="series-s" /> Xbox Series S</label>
