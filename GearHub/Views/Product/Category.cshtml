                        <select name="sort" aria-label="Sắp xếp sản phẩm">
                            <option value="newest">Mới nhất</option>
                            <option value="price-low">Giá tăng dần</option>
                            <option value="price-high">Giá giảm dần</option>
                            <option value="name">Tên A-Z</option>
                        </select>
                    </label>
                </div>

                <!-- Danh sách hiển thị dữ liệu đã nhập từ trang quản trị, không tự tạo sản phẩm mẫu. -->
                <div class="category-product-grid">
                    @if (products.Count == 0)
                    {
                        <div class="category-empty-state">
                            <span class="category-empty-symbol" aria-hidden="true">GH</span>
                            <h2>Chưa có sản phẩm @categoryName</h2>
                            <p>Sản phẩm sẽ xuất hiện ở đây sau khi được thêm từ trang quản trị.</p>
                        </div>
                    }
                    else
                    {
                        foreach (var product in products)
                        {
                            <a class="catalog-product-link" href="@Url.Action("Detail", "Product", new { id = product.Id })">
                            <article class="catalog-product-card">
                                <div class="catalog-product-image">
                                    <img src="@Url.Content(product.ImagePath)" alt="@product.Name" />
                                </div>
                                <div class="catalog-product-info">
                                    <span class="catalog-product-category">@product.CategoryName</span>
                                    <h2>@product.Name</h2>
                                    <p class="catalog-product-description">@product.Description</p>
                                    <div class="catalog-product-specs">@product.Specifications</div>
                                    <strong class="catalog-product-price">@product.Price.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"))đ</strong>
                                </div>
                            </article>
                            </a>
                        }
                    }
                </div>
            </section>
        </div>
    </div>
</main>
